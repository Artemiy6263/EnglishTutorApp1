<Window x:Class="EnglishTutor.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация студента" Width="560" Height="720" MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Background="White" CornerRadius="16" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.1" ShadowDepth="0"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border Background="#3B6FE8" Padding="24,28">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="40"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Регистрация"
                                   FontFamily="Lora" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Создайте аккаунт студента"
                                   FontFamily="Nunito" FontSize="13"
                                   Foreground="White" Opacity="0.8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="36,28,36,36">

                    <TextBlock Text="Логин *"
                               FontFamily="Nunito" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername"
                             Style="{StaticResource ModernTextBox}"
                             Height="46" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="Минимум 3 символа, только латиница и цифры"
                               FontFamily="Nunito" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,16"/>

                    <TextBlock Text="Email (необязательно)"
                               FontFamily="Nunito" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEmail"
                             Style="{StaticResource ModernTextBox}"
                             Height="46" FontSize="14" Margin="0,0,0,20"/>

                    <TextBlock Text="Пароль *"
                               FontFamily="Nunito" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PbPassword"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Height="46" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="Минимум 6 символов"
                               FontFamily="Nunito" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,16"/>

                    <TextBlock Text="Подтвердите пароль *"
                               FontFamily="Nunito" FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PbConfirm"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Height="46" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtError"
                               FontFamily="Nunito" FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="#E8536A"
                               Visibility="Collapsed" Margin="0,0,0,12"/>

                    <Button x:Name="BtnRegister" Content="Зарегистрироваться"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" FontSize="16"
                            Margin="0,8,0,0"
                            Click="BtnRegister_Click"/>

                    <Button x:Name="BtnCancel" Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Height="44" FontSize="14"
                            Margin="0,10,0,0"
                            Click="BtnCancel_Click"/>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
