<Window x:Class="EnglishTutor.Windows.Student.ExerciseTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание: Перевод" Width="700" Height="540"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="28">
        <Grid Margin="0,0,0,4"><TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><TextBlock x:Name="TxtTimer" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="⏱ 00:00"/></Grid>
        <ProgressBar x:Name="PbProgress" Style="{StaticResource ModernProgressBar}" Margin="0,12,0,20" Maximum="100" Minimum="0" Value="0"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtQuestion" FontFamily="Lora" FontSize="42" FontWeight="Bold" Foreground="#3B6FE8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                <TextBlock Text="Выберите правильный перевод:" Style="{StaticResource SubText}" Margin="0,0,0,12"/>
                <UniformGrid x:Name="UgOptions" Rows="2" Columns="2"/>
                <TextBlock x:Name="TxtFeedback" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock x:Name="TxtScore" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,24,0" Text="Счёт: 0"/>
            <Button x:Name="BtnNext" Content="Следующий ▶" Style="{StaticResource PrimaryButton}" Click="BtnNext_Click" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
