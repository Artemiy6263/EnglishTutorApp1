<Window x:Class="EnglishTutor.Windows.Student.ExerciseSpellingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание: Правописание" Width="680" Height="500"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="28">
        <Grid Margin="0,0,0,4"><TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><TextBlock x:Name="TxtTimer" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="⏱ 00:00"/></Grid>
        <ProgressBar x:Name="PbProgress" Style="{StaticResource ModernProgressBar}" Margin="0,12,0,20" Maximum="100" Minimum="0"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Напишите слово по-английски:" Style="{StaticResource SubText}" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtQuestion" FontFamily="Lora" FontSize="28" FontWeight="Bold" Foreground="#3B6FE8" HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="TxtHint" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBox x:Name="TxtAnswer" Style="{StaticResource ModernTextBox}" Height="48" FontSize="18" TextAlignment="Center" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Content="💡 Подсказка" Style="{StaticResource SecondaryButton}" Click="BtnHint_Click" Margin="0,0,8,0"/>
                    <Button Content="✔ Проверить" Style="{StaticResource PrimaryButton}" Click="BtnCheck_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtFeedback" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="BtnNext" Content="Следующий ▶" Style="{StaticResource PrimaryButton}" Click="BtnNext_Click" IsEnabled="False" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="TxtScore" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Счёт: 0"/>
    </StackPanel>
</Window>
