<Window x:Class="EnglishTutor.Windows.Student.ExerciseTensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание: Времена" Width="720" Height="520"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="28">
        <Grid Margin="0,0,0,4"><TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><TextBlock x:Name="TxtTimer" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="⏱ 00:00"/></Grid>
        <ProgressBar x:Name="PbProgress" Style="{StaticResource ModernProgressBar}" Margin="0,12,0,20" Maximum="100" Minimum="0"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Выберите правильную форму глагола:" Style="{StaticResource SubText}" Margin="0,0,0,16"/>
                <TextBlock x:Name="TxtQuestion" FontFamily="Lora" FontSize="22" FontWeight="Bold" Foreground="#1A1D3A" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                <UniformGrid x:Name="UgOptions" Rows="2" Columns="2"/>
                <TextBlock x:Name="TxtFeedback" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button x:Name="BtnNext" Content="Следующий ▶" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="BtnNext_Click" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="TxtScore" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Счёт: 0"/>
    </StackPanel>
</Window>
