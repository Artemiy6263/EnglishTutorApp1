<Window x:Class="EnglishTutor.Windows.Student.LessonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EnglishTutor.Converters"
        Title="Уроки" Width="900" Height="650"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,20"><TextBlock Text="📖 Уроки" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><Button Content="← Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnBack_Click"/></Grid>
            <ListBox x:Name="LbLessons" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallCard}" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="LessonSelected"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding IconEmoji}" FontSize="36" VerticalAlignment="Center" Margin="0,0,16,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Separator Margin="0,16"/>
            <TextBlock x:Name="TxtLessonTitle" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,0,0,12"/>
            <DataGrid x:Name="DgWords" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Английское слово" Binding="{Binding EnglishWord}" Width="180"/>
                    <DataGridTextColumn Header="Транскрипция" Binding="{Binding Transcription}" Width="140"/>
                    <DataGridTextColumn Header="Перевод" Binding="{Binding RussianTranslation}" Width="*"/>
                    <DataGridTextColumn Header="Пример" Binding="{Binding ExampleSentence}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Window>
