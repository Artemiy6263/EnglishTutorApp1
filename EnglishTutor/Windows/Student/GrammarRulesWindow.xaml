<Window x:Class="EnglishTutor.Windows.Student.GrammarRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Грамматика" Width="1000" Height="680"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2A3F7E" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📚 Грамматика" FontFamily="Lora" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                <Button DockPanel.Dock="Bottom" Content="← Назад" Click="BtnBack_Click" FontFamily="Nunito" FontSize="13" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="12,8" Cursor="Hand" Margin="0,12,0,0"/>
                <ListBox x:Name="LbTenses" Background="Transparent" BorderThickness="0" SelectionChanged="TenseSelected">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3B6FE8"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Padding="12,10" Cursor="Hand" CornerRadius="6"><TextBlock Text="{Binding Name}" Foreground="White" FontFamily="Nunito" FontSize="13"/></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock x:Name="TxtTenseName" FontFamily="Lora" FontSize="26" FontWeight="Bold" Foreground="#1A1D3A" Margin="0,0,0,8" Text="Выберите время из списка слева"/>
                <TextBlock x:Name="TxtTenseDesc" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Border Background="#EBF0FD" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel><TextBlock Text="📐 Формула" Style="{StaticResource SubText}" Margin="0,0,0,8"/><TextBlock x:Name="TxtFormula" FontFamily="Lora" FontSize="16" Foreground="#3B6FE8" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <TextBlock Text="Примеры:" FontFamily="Nunito" FontSize="16" FontWeight="SemiBold" Foreground="#1A1D3A" Margin="0,0,0,8"/>
                <Border Background="#F8F9FF" CornerRadius="8" Padding="16" Margin="0,0,0,16"><TextBlock x:Name="TxtExamples" FontFamily="Courier New" FontSize="13" TextWrapping="Wrap" Foreground="#1A1D3A"/></Border>
                <TextBlock Text="Правила:" FontFamily="Nunito" FontSize="16" FontWeight="SemiBold" Foreground="#1A1D3A" Margin="0,0,0,12"/>
                <ItemsControl x:Name="IcRules">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Title}" FontFamily="Nunito" FontSize="14" FontWeight="Bold" Foreground="#1A1D3A" Margin="0,0,0,4"/><TextBlock Text="{Binding Content}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Examples}" Style="{StaticResource SubText}" Margin="0,8,0,0" FontStyle="Italic" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
