<Window x:Class="EnglishTutor.Windows.Student.WordStudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изучение слов" Width="700" Height="580"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="24">
        <Grid Margin="0,0,0,16"><TextBlock Text="📝 Изучение слов" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><Button Content="← Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnBack_Click"/></Grid>
        <ComboBox x:Name="CbDifficulty" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12" SelectionChanged="DifficultyChanged"><ComboBoxItem Content="Все уровни"/><ComboBoxItem Content="Лёгкий"/><ComboBoxItem Content="Средний"/><ComboBoxItem Content="Сложный"/></ComboBox>
        <TextBlock x:Name="TxtProgress" Style="{StaticResource SubText}" Margin="0,0,0,16"/>
        <Border Style="{StaticResource Card}" MinHeight="280">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <TextBlock x:Name="TxtEnglish" FontFamily="Lora" FontSize="48" FontWeight="Bold" Foreground="#3B6FE8" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtTranscription" Style="{StaticResource SubText}" HorizontalAlignment="Center" FontSize="18" Margin="0,8,0,24"/>
                <Button x:Name="BtnReveal" Content="Показать перевод" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="BtnReveal_Click"/>
                <StackPanel x:Name="PanelAnswer" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="TxtTranslation" FontFamily="Lora" FontSize="32" Foreground="#3BAE6E" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtExample" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtApiDef" Style="{StaticResource SubText}" TextWrapping="Wrap" HorizontalAlignment="Center" FontStyle="Italic" TextAlignment="Center" Margin="0,0,0,16"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="◀ Предыдущее" Style="{StaticResource SecondaryButton}" Click="BtnPrev_Click" Margin="0,0,8,0"/>
            <Button Content="🔍 Словарь" Style="{StaticResource SecondaryButton}" Click="BtnApi_Click" Margin="0,0,8,0"/>
            <Button Content="Следующее ▶" Style="{StaticResource PrimaryButton}" Click="BtnNext_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
