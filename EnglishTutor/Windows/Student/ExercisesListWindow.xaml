<Window x:Class="EnglishTutor.Windows.Student.ExercisesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EnglishTutor.Converters"
        Title="Задания" Width="900" Height="680"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries><converters:DifficultyToColorConverter x:Key="DiffToColor"/><converters:DifficultyToTextConverter x:Key="DiffToText"/></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,20"><TextBlock Text="✏️ Задания" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><Button Content="← Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnBack_Click"/></Grid>
            <TextBlock Text="🔤 Перевод" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
            <ItemsControl x:Name="IcTranslation"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallCard}" Width="250" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="ExerciseSelected"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" Margin="0,4,0,8" TextWrapping="Wrap"/><Border Background="{Binding DifficultyLevel, Converter={StaticResource DiffToColor}}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding DifficultyLevel, Converter={StaticResource DiffToText}}" Foreground="White" FontSize="11" FontFamily="Nunito"/></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="✍️ Правописание" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
            <ItemsControl x:Name="IcSpelling"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallCard}" Width="250" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="ExerciseSelected"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" Margin="0,4,0,8" TextWrapping="Wrap"/><Border Background="{Binding DifficultyLevel, Converter={StaticResource DiffToColor}}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding DifficultyLevel, Converter={StaticResource DiffToText}}" Foreground="White" FontSize="11" FontFamily="Nunito"/></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="⏰ Времена" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
            <ItemsControl x:Name="IcTenses"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SmallCard}" Width="250" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="ExerciseSelected"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" Margin="0,4,0,8" TextWrapping="Wrap"/><Border Background="{Binding DifficultyLevel, Converter={StaticResource DiffToColor}}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding DifficultyLevel, Converter={StaticResource DiffToText}}" Foreground="White" FontSize="11" FontFamily="Nunito"/></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
