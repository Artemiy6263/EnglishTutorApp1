<Window x:Class="EnglishTutor.Windows.Admin.ManageUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2A3F7E">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#3B6FE8" Padding="20,24"><StackPanel><TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="EnglishTutor" FontFamily="Lora" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Администратор" FontFamily="Nunito" FontSize="11" Foreground="#B8C5E8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
                <Button DockPanel.Dock="Bottom" Content="🚪  Выйти" Style="{StaticResource NavButton}" Click="NavLogout_Click" Margin="8,8"/>
                <StackPanel Margin="8,16,8,0">
                    <Button Content="🏠  Дашборд" Style="{StaticResource NavButton}" Click="NavDashboard_Click"/>
                    <Button Content="👥  Пользователи" Style="{StaticResource NavButtonActive}"/>
                    <Button Content="📝  Слова" Style="{StaticResource NavButton}" Click="NavWords_Click"/>
                    <Button Content="📖  Уроки" Style="{StaticResource NavButton}" Click="NavLessons_Click"/>
                    <Button Content="✏️  Задания" Style="{StaticResource NavButton}" Click="NavExercises_Click"/>
                    <Button Content="📊  Статистика" Style="{StaticResource NavButton}" Click="NavStats_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16"><TextBlock Text="Управление пользователями" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/><Button Content="➕  Новый пользователь" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="BtnNew_Click"/></Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DataGrid x:Name="DgUsers" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" SelectionChanged="DgUsers_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="60"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="160"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="120"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="110"/>
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Редактирование / Создание" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Логин" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtLogin" Style="{StaticResource ModernTextBox}" Height="40" Margin="0,0,0,12"/>
                            <TextBlock Text="Email" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Пароль (пусто = не менять)" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPassword" Style="{StaticResource ModernTextBox}" Height="40" Margin="0,0,0,12"/>
                            <TextBlock Text="Роль" Style="{StaticResource SubText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CbRole" Style="{StaticResource ModernComboBox}" Height="40"><ComboBoxItem Content="Студент"/><ComboBoxItem Content="Администратор"/></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkActive" Content="Активен" FontFamily="Nunito" FontSize="14" IsChecked="True" Margin="0,0,0,16"/>
                            <Button Content="💾  Сохранить" Style="{StaticResource SuccessButton}" Height="40" Margin="0,0,0,8" Click="BtnSave_Click"/>
                            <Button Content="🗑️  Удалить" Style="{StaticResource DangerButton}" Height="40" Margin="0,0,0,8" Click="BtnDelete_Click"/>
                            <Button Content="✖  Очистить" Style="{StaticResource SecondaryButton}" Height="40" Click="BtnNew_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
