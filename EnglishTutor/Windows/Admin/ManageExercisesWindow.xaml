<Window x:Class="EnglishTutor.Windows.Admin.ManageExercisesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление заданиями" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2A3F7E"><DockPanel><Border DockPanel.Dock="Top" Background="#3B6FE8" Padding="20,24"><StackPanel><TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="EnglishTutor" FontFamily="Lora" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Администратор" FontFamily="Nunito" FontSize="11" Foreground="#B8C5E8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border><Button DockPanel.Dock="Bottom" Content="🚪  Выйти" Style="{StaticResource NavButton}" Click="NavLogout_Click" Margin="8,8"/><StackPanel Margin="8,16,8,0"><Button Content="🏠  Дашборд" Style="{StaticResource NavButton}" Click="NavDashboard_Click"/><Button Content="👥  Пользователи" Style="{StaticResource NavButton}" Click="NavUsers_Click"/><Button Content="📝  Слова" Style="{StaticResource NavButton}" Click="NavWords_Click"/><Button Content="📖  Уроки" Style="{StaticResource NavButton}" Click="NavLessons_Click"/><Button Content="✏️  Задания" Style="{StaticResource NavButtonActive}"/><Button Content="📊  Статистика" Style="{StaticResource NavButton}" Click="NavStats_Click"/></StackPanel></DockPanel></Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Управление заданиями" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                <DataGrid x:Name="DgExercises" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" SelectionChanged="DgExercises_SelectionChanged">
                    <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding ExerciseId}" Width="50"/><DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Уровень" Binding="{Binding DifficultyLevel}" Width="100"/><DataGridTextColumn Header="Вопросов" Binding="{Binding Questions.Count}" Width="90"/><DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Название" Style="{StaticResource SubText}" Margin="0,0,0,4"/><TextBox x:Name="TxtTitle" Style="{StaticResource ModernTextBox}" Height="40" Margin="0,0,0,10"/><TextBlock Text="Описание" Style="{StaticResource SubText}" Margin="0,0,0,4"/><TextBox x:Name="TxtDesc" Style="{StaticResource ModernTextBox}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Тип задания" Style="{StaticResource SubText}" Margin="0,0,0,4"/><ComboBox x:Name="CbType" Style="{StaticResource ModernComboBox}" Height="40" Margin="0,0,0,10" SelectedIndex="0"><ComboBoxItem Content="Перевод"/><ComboBoxItem Content="Правописание"/><ComboBoxItem Content="Времена"/></ComboBox><TextBlock Text="Уровень" Style="{StaticResource SubText}" Margin="0,0,0,4"/><ComboBox x:Name="CbLevel" Style="{StaticResource ModernComboBox}" Height="40" Margin="0,0,0,10" SelectedIndex="0"><ComboBoxItem Content="Лёгкий"/><ComboBoxItem Content="Средний"/><ComboBoxItem Content="Сложный"/></ComboBox><TextBlock Text="Время (сек)" Style="{StaticResource SubText}" Margin="0,0,0,4"/><TextBox x:Name="TxtTime" Style="{StaticResource ModernTextBox}" Height="40"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="160"><CheckBox x:Name="ChkActive" Content="Активно" FontFamily="Nunito" FontSize="14" IsChecked="True" Margin="0,0,0,12"/><Button Content="💾  Сохранить" Style="{StaticResource SuccessButton}" Height="40" Margin="0,0,0,8" Click="BtnSave_Click"/><Button Content="🗑️  Удалить" Style="{StaticResource DangerButton}" Height="40" Click="BtnDelete_Click"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
