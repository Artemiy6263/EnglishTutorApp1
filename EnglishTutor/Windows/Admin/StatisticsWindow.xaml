<Window x:Class="EnglishTutor.Windows.Admin.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2A3F7E"><DockPanel><Border DockPanel.Dock="Top" Background="#3B6FE8" Padding="20,24"><StackPanel><TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center"/><TextBlock Text="EnglishTutor" FontFamily="Lora" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Администратор" FontFamily="Nunito" FontSize="11" Foreground="#B8C5E8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border><Button DockPanel.Dock="Bottom" Content="🚪  Выйти" Style="{StaticResource NavButton}" Click="NavLogout_Click" Margin="8,8"/><StackPanel Margin="8,16,8,0"><Button Content="🏠  Дашборд" Style="{StaticResource NavButton}" Click="NavDashboard_Click"/><Button Content="👥  Пользователи" Style="{StaticResource NavButton}" Click="NavUsers_Click"/><Button Content="📝  Слова" Style="{StaticResource NavButton}" Click="NavWords_Click"/><Button Content="📖  Уроки" Style="{StaticResource NavButton}" Click="NavLessons_Click"/><Button Content="✏️  Задания" Style="{StaticResource NavButton}" Click="NavExercises_Click"/><Button Content="📊  Статистика" Style="{StaticResource NavButtonActive}"/></StackPanel></DockPanel></Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="Статистика" Style="{StaticResource PageTitle}"/><TextBlock Text="Обзор успеваемости студентов" Style="{StaticResource SubText}"/></StackPanel>
            <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource SmallCard}" Margin="0,0,8,0"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtStudents" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Студентов" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SmallCard}" Margin="4,0"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtPassed" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Заданий сдано" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource SmallCard}" Margin="8,0,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="TxtTotalScore" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Суммарный балл" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="🏆" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <TabControl Grid.Row="2">
                <TabItem Header="По студентам"><DataGrid x:Name="DgByStudent" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Студент" Binding="{Binding Student}" Width="*"/><DataGridTextColumn Header="Заданий" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="Лучший балл" Binding="{Binding BestScore}" Width="120"/><DataGridTextColumn Header="Последняя активность" Binding="{Binding Last}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
                <TabItem Header="По заданиям"><DataGrid x:Name="DgByExercise" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Задание" Binding="{Binding Exercise}" Width="*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Попыток" Binding="{Binding Attempts}" Width="100"/><DataGridTextColumn Header="Средний балл" Binding="{Binding AvgScore, StringFormat=F1}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
