<Window x:Class="EnglishTutor.Windows.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EnglishTutor — Администратор" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen" Background="#F0F4FF">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2A3F7E">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#3B6FE8" Padding="20,24">
                    <StackPanel>
                        <TextBlock Text="📚" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="EnglishTutor" FontFamily="Lora" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Администратор" FontFamily="Nunito" FontSize="11" Foreground="#B8C5E8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Bottom" Content="🚪  Выйти" Style="{StaticResource NavButton}" Click="NavLogout_Click" Margin="8,8"/>
                <StackPanel Margin="8,16,8,0">
                    <Button Content="🏠  Дашборд" Style="{StaticResource NavButtonActive}"/>
                    <Button Content="👥  Пользователи" Style="{StaticResource NavButton}" Click="NavUsers_Click"/>
                    <Button Content="📝  Слова" Style="{StaticResource NavButton}" Click="NavWords_Click"/>
                    <Button Content="📖  Уроки" Style="{StaticResource NavButton}" Click="NavLessons_Click"/>
                    <Button Content="✏️  Задания" Style="{StaticResource NavButton}" Click="NavExercises_Click"/>
                    <Button Content="📊  Статистика" Style="{StaticResource NavButton}" Click="NavStats_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="Панель администратора" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtWelcome" Style="{StaticResource SubText}" Margin="0,0,0,24"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,24">
                    <Border Style="{StaticResource SmallCard}" Margin="0,0,12,0"><StackPanel><TextBlock x:Name="TxtUserCount" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Пользователей" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource SmallCard}" Margin="0,0,12,0"><StackPanel><TextBlock x:Name="TxtWordCount" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Слов в базе" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource SmallCard}" Margin="0,0,12,0"><StackPanel><TextBlock x:Name="TxtExerciseCount" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Заданий" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="✏️" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource SmallCard}"><StackPanel><TextBlock x:Name="TxtProgressCount" Text="0" Style="{StaticResource StatNumber}"/><TextBlock Text="Записей прогресса" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Последняя активность" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                        <DataGrid x:Name="DgRecent" Style="{StaticResource ModernDataGrid}" MaxHeight="320" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Студент" Binding="{Binding User.Username}" Width="160"/>
                                <DataGridTextColumn Header="Задание" Binding="{Binding Exercise.Title}" Width="*"/>
                                <DataGridTextColumn Header="Счёт" Binding="{Binding Score}" Width="80"/>
                                <DataGridTextColumn Header="Макс" Binding="{Binding MaxScore}" Width="80"/>
                                <DataGridTextColumn Header="Попыток" Binding="{Binding Attempts}" Width="80"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding CompletedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
